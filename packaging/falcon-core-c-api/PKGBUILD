(library only)
pkgname=falcon-core-c-api
pkgver=1.0.0
pkgrel=1
arch=('x86_64')
pkgdesc="Falcon Core C++ shared library"
license=('MIT')
depends=(
  'boost-libs>=1.88.0'
  'bzip2>=1.0.8'
  'hdf5>=1.14.6'
  'yaml-cpp>=0.8.0'
  'xtensor>=0.25.0'
  'xtensor-io>=0.13.0'
  'xtl>=0.7.5'
  'xsimd>=10.0.0'
  'cereal>=1.3.2'
  'exprtk>=0.0.2'
  'expat>=2.7.1'
  'highfive>=3.1.1'
  'pybind11>=3.0.1'
  'gtest>=1.16.0'
  'nlohmann-json>=3.12.0'
  'openssl>=3.5.2'
  'sqlite>=3.50.4'
  'zlib>=1.3.1'
  'falcon-core-cpp'
)
makedepends=('llvm' 'clang')
source=("git+ssh://git@github.com/falcon-autotuning/falcon-core.git#branch=new-dev")
sha256sums=('SKIP')
build() {
  cd "$srcdir/falcon-core/c-api" || exit
  make build-dev USE_VCPKG=0
}
package() {
  install -Dm755 build/libfalcon_core_cpp.so "$pkgdir/usr/lib/libfalcon_core_c_api.so"
  install -d "$pkgdir/usr/include/falcon-core-c-api"
  cp -r include/falcon_core/* "$pkgdir/usr/include/falcon-core-c-api/"
}
