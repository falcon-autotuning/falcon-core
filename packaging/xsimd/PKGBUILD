# Maintainer: <tkovach@wisc.edu>
pkgname=xsimd
pkgver=10.0.0
pkgrel=1
pkgdesc="C++ wrappers for SIMD intrinsics"
arch=('any')
url="https://github.com/xtensor-stack/xsimd"
license=('BSD')
makedepends=('cmake')
source=("$pkgname-$pkgver.tar.gz::https://github.com/xtensor-stack/xsimd/archive/refs/tags/$pkgver.tar.gz")
sha256sums=('73f818368b3a4dad92fab1b2933d93694241bd2365a6181747b2df1768f6afdd')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  cmake -DCMAKE_INSTALL_PREFIX="/usr" -DCMAKE_POLICY_VERSION_MINIMUM=3.5 .
  make
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  make DESTDIR="$pkgdir" install
}
