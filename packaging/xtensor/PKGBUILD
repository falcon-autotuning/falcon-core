# Maintainer: <tkovach@wisc.edu>
pkgname=xtensor
pkgver=0.25.0
pkgrel=1
pkgdesc="C++ tensors with broadcasting and lazy computing"
arch=('any')
url="https://github.com/xtensor-stack/xtensor"
license=('BSD')
depends=('gcc' 'cmake')
makedepends=('cmake')
source=("$pkgname-$pkgver.tar.gz::https://github.com/xtensor-stack/xtensor/archive/refs/tags/$pkgver.tar.gz")
sha256sums=('32d5d9fd23998c57e746c375a544edf544b74f0a18ad6bc3c38cbba968d5e6c7')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  cmake -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_POLICY_VERSION_MINIMUM=3.5 .
  make
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  make DESTDIR="$pkgdir" install
}
