# Maintainer: <tkovach@wisc.edu>
pkgname=xtl
pkgver=0.7.5
pkgrel=1
pkgdesc="C++ implementation of common tools used in the xtensor ecosystem"
arch=('any')
url="https://github.com/xtensor-stack/xtl"
license=('BSD')
makedepends=('cmake')
source=("$pkgname-$pkgver.tar.gz::https://github.com/xtensor-stack/xtl/archive/refs/tags/$pkgver.tar.gz")
sha256sums=('3286fef5fee5d58f82f7b91375cd449c819848584bae9367893501114d923cbe')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  cmake -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_POLICY_VERSION_MINIMUM=3.5 .
  make
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  make DESTDIR="$pkgdir" install
}
