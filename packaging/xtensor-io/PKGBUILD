# Maintainer: <tkovach@wisc.edu>
pkgname=xtensor-io
pkgver=0.13.0
pkgrel=1
pkgdesc="IO functionalities for xtensor"
arch=('any')
url="https://github.com/xtensor-stack/xtensor-io"
license=('BSD')
depends=('xtensor')
makedepends=('cmake')
source=("$pkgname-$pkgver.tar.gz::https://github.com/xtensor-stack/xtensor-io/archive/refs/tags/$pkgver.tar.gz")
sha256sums=('470bedee082adb0ef25ef7b54f9cfd3684e27b8489c42cf7980e0d90c14d04da')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  cmake -DCMAKE_INSTALL_PREFIX="/usr" .
  make
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  make DESTDIR="$pkgdir" install
}
