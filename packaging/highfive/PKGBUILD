# Maintainer: <tkovach@wisc.edu>
pkgname=highfive
pkgver=3.3.0
pkgrel=1
pkgdesc="HighFive is a modern, user-friendly, header-only, C++14 interface for libhdf5."
arch=('any')
url="https://github.com/highfive-devs/highfive"
license=('BSL')
depends=('boost', 'cmake', 'eigen', 'hdf5', 'catch2')
makedepends=('cmake')
source=("$pkgname-$pkgver.tar.gz::https://github.com/highfive-devs/highfive/archive/refs/tags/$pkgver.tar.gz")
sha256sums=('325cfbcf0c0296a6dd26f3b088801b7ebb8d6f109c0565c11d2d8c4af3253bff')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  cmake -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
    -DHIGHFIVE_UNIT_TESTS=OFF -DHIGHFIVE_EXAMPLES=OFF -DHIGHFIVE_BUILD_DOCS=OFF .
  make
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  make DESTDIR="$pkgdir" install
}
