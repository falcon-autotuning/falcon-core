      <memberdef kind="define" id="CerealMacro__c__api_8h_1ac951680299891e9d683cab165ea3d831" prot="public" static="no">
        <name>DEFINE_C_API_FROM_JSON_TEMPLATE</name>
        <param><defname>CType</defname></param>
        <param><defname>CPPType</defname></param>
        <initializer>  CType##Handle CType##_from_json_string(StringHandle json) {                \
    FALCON_C_API_BEGIN                                                       \
    if (!json) {                                                             \
      throw std::invalid_argument(#CType                                     \
                                  &quot;_from_json_string: json cannot be null&quot;); \
    }                                                                        \
    std::string raw_json(json-&gt;raw);                                         \
    auto        ptr = CPPType::from_json_string&lt;CPPType&gt;(raw_json);          \
    return new std::shared_ptr&lt;CPPType&gt;(ptr);                                \
    FALCON_C_API_END(nullptr)                                                \
  }</initializer>
