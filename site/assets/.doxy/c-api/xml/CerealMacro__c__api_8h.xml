        <name>DEFINE_C_API_TO_JSON_TEMPLATE</name>
        <param><defname>CType</defname></param>
        <param><defname>CPPType</defname></param>
        <initializer>  StringHandle CType##_to_json_string(CType##Handle handle) {                \
    FALCON_C_API_BEGIN                                                       \
    if (!handle) {                                                           \
      throw std::invalid_argument(#CType                                     \
                                  &quot;_to_json_string: handle cannot be null&quot;); \
    }                                                                        \
    std::shared_ptr&lt;CPPType&gt; self =                                          \
        *static_cast&lt;std::shared_ptr&lt;CPPType&gt;*&gt;(handle);                     \
    std::string json = self-&gt;to_json_string();                               \
    return String_create(json.c_str(), json.size());                         \
    FALCON_C_API_END(nullptr)                                                \
  }</initializer>
