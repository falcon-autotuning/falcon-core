# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]

# ignore vcpkg since it is large
/vcpkg
/vcpkg_installed
/vcpkg*

# .pyenv file
.python-version

# build python package
/src/falcon_core/*

# ipython extras
.ipynb_checkpoints/

# C extensions
*.so

