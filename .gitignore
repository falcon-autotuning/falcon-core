htmlcov/
.tox/
.coverage
.coverage.*
.cache
.pytest_cache/*

nosetests.xml
coverage.xml
*,cover
.hypothesis

# Translations
*.mo
*.pot


# Sphinx documentation
docs/_build/
docs/_notebooks
docs/api/generated/
docs/_auto

