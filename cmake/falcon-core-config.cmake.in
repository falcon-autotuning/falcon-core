@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(cereal)
find_dependency(xtl)
find_dependency(xtensor)
find_dependency(xsimd)
find_dependency(yaml-cpp)
find_dependency(HDF5 COMPONENTS HL CXX zlib szip)
find_dependency(Boost COMPONENTS filesystem uuid)
find_dependency(Threads)

# This checks if the C-API was built and installed.
# The variable FALCON_CORE_HAS_C_API will be set to TRUE in the
# main CMakeLists.txt if the feature was enabled during the build.
@FALCON_CORE_C_API_CONFIG@

# Include the targets file (falcon-core-targets.cmake)
# This file is generated by the `install(EXPORT ...)` command and defines
# the falcon_core::falcon-core and (if available) falcon_core::falcon-core-c-api targets.
include("${CMAKE_CURRENT_LIST_DIR}/falcon-core-targets.cmake")
check_required_components(falcon-core-cpp)
