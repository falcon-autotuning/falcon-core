@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(xtensor CONFIG REQUIRED)
find_dependency(Boost CONFIG REQUIRED COMPONENTS filesystem uuid)

set("falcon-core_c-api_FOUND" @FALCON_CORE_HAS_C_API@)

include(
  "${CMAKE_CURRENT_LIST_DIR}/falcon-core-targets.cmake"
)

check_required_components(falcon-core)
